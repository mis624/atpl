function testCreateCustomizeInward() {
  const projects =
    getSheetObjects_(
      APP_CONFIG.SHEETS.PROJECT_MASTER
    ).filter(function (record) {
      return (
        normalizeText_(
          record['Project ID']
        ) &&
        normalizeUpper_(
          record['Status']
        ) === 'ACTIVE'
      );
    });

  if (!projects.length) {
    throw new Error(
      'No ACTIVE project found in Project_Master.'
    );
  }

  const skus =
    getSheetObjects_(
      APP_CONFIG.SHEETS.SKU_MASTER
    ).filter(function (record) {
      return (
        normalizeText_(
          record['SKU ID']
        ) &&
        normalizeUpper_(
          record['Status']
        ) === 'ACTIVE'
      );
    });

  if (!skus.length) {
    throw new Error(
      'No ACTIVE SKU found in SKU_Master.'
    );
  }

  const selectedProject =
    projects[0];

  const selectedSku =
    skus[0];

  const result =
    createInward({
      inventoryType:
        'CUSTOMIZE',

      vendor:
        'Test Vendor',

      vendorInvoiceNo:
        'TEST-' + Date.now(),

      projectId:
        normalizeUpper_(
          selectedProject['Project ID']
        ),

      remarks:
        'Automatic customize inward test.',

      items: [
        {
          skuId:
            normalizeUpper_(
              selectedSku['SKU ID']
            ),

          quantity:
            3
        }
      ]
    });

  Logger.log(
    JSON.stringify(
      {
        selectedProject:
          selectedProject,

        selectedSku:
          selectedSku,

        result:
          result
      },
      null,
      2
    )
  );

  return result;
}
